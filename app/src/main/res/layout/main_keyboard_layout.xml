<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_keyboard_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F172A">

    <LinearLayout
        android:id="@+id/ll_main_keyboard_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Action Bar -->
        <LinearLayout
            android:id="@+id/ll_top_action_bar"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:background="#1E293B">

            <TextView
                android:id="@+id/btn_translate_action"
                android:layout_width="42dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:gravity="center"
                android:text="文A"
                android:textColor="#94A3B8"
                android:textSize="15sp"
                android:textStyle="bold"
                android:contentDescription="Live Translator" />

            <TextView
                android:id="@+id/btn_trackpad_action"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="✥"
                android:textColor="#94A3B8"
                android:textSize="17sp"
                android:textStyle="bold"
                android:contentDescription="Cursor Trackpad" />

            <TextView
                android:id="@+id/btn_emoji_action"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="😊"
                android:textSize="16sp"
                android:contentDescription="Emoji Panel" />

            <TextView
                android:id="@+id/tv_keyboard_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingHorizontal="6dp"
                android:text="UV Keyboard • জাতীয়"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_mode_badge"
                android:layout_width="36dp"
                android:layout_height="24dp"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="BN"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dynamic Extension Slot (Translator View) -->
        <FrameLayout
            android:id="@+id/extensionHeaderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Main Keyboard Frame (fixed height equal to active keyboard height) -->
        <FrameLayout
            android:id="@+id/keyboardContainer"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="#0F172A">

            <!-- Default layer: BaseKeyboardView container -->
            <FrameLayout
                android:id="@+id/fl_keyboard_canvas_holder"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- CursorTrackpadView as full-height overlay inside keyboardContainer -->
            <com.example.keyboard.ui.CursorTrackpadView
                android:id="@+id/cursorTrackpadView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- Container for Emoji Keyboard View -->
    <FrameLayout
        android:id="@+id/fl_emoji_canvas_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</FrameLayout>
