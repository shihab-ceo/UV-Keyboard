<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_keyboard_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F172A">

    <!-- Custom Gallery Image Background with centerCrop -->
    <ImageView
        android:id="@+id/iv_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Keyboard Background"
        android:visibility="gone" />

    <!-- Adjustable Opacity Overlay -->
    <View
        android:id="@+id/v_bg_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/ll_keyboard_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="4dp">

        <!-- Candidate / Prediction Bar -->
        <LinearLayout
            android:id="@+id/ll_candidate_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:background="#1E293B">

            <!-- Dynamic Switcher Icon Button -->
            <TextView
                android:id="@+id/btn_switch_mode"
                android:layout_width="44dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="🌐"
                android:textSize="18sp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Switch Layout Mode" />

            <!-- Clipboard Quick Access Button -->
            <TextView
                android:id="@+id/btn_clipboard_quick"
                android:layout_width="40dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="📋"
                android:textSize="16sp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Smart Clipboard" />

            <!-- Candidates Container (Horizontal Scroll) -->
            <HorizontalScrollView
                android:id="@+id/hsv_candidates"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/ll_candidates_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp" />
            </HorizontalScrollView>

            <!-- Voice Microphone Button -->
            <TextView
                android:id="@+id/btn_voice_mic"
                android:layout_width="44dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="🎙️"
                android:textSize="18sp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voice to Text" />
        </LinearLayout>

        <!-- Smart Clipboard Panel (Shown when clipboard button tapped) -->
        <LinearLayout
            android:id="@+id/ll_clipboard_panel"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:orientation="vertical"
            android:background="#182234"
            android:padding="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tv_clipboard_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📌 স্মার্ট ক্লিপবোর্ড (৩ দিনের ইতিহাস)"
                    android:textColor="#38BDF8"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_close_clipboard"
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_clipboard_items"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Emoji Panel (Shown when emoji button tapped) -->
        <LinearLayout
            android:id="@+id/ll_emoji_panel"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:orientation="vertical"
            android:background="#182234"
            android:padding="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ইমোজি (Emojis)"
                    android:textColor="#A855F7"
                    android:textStyle="bold"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_close_emoji"
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:background="?android:attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_emoji_items"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Dynamic Keyboard Rows Container -->
        <LinearLayout
            android:id="@+id/ll_keyboard_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="2dp"
            android:paddingTop="2dp" />

    </LinearLayout>
</FrameLayout>
